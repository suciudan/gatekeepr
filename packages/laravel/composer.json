{
	"name": "gatekeepr/laravel",
	"description": "Laravel middleware and client helpers for Gatekeepr signup and login abuse protection.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"gatekeepr",
		"laravel",
		"middleware",
		"abuse-prevention",
		"signup-protection",
		"fraud-protection"
	],
	"require": {
		"php": "^8.1",
		"illuminate/contracts": "^10.0|^11.0|^12.0",
		"illuminate/http": "^10.0|^11.0|^12.0",
		"illuminate/support": "^10.0|^11.0|^12.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5|^11.0"
	},
	"autoload": {
		"psr-4": {
			"Gatekeepr\\Laravel\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Gatekeepr\\Laravel\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Gatekeepr\\Laravel\\GatekeeprServiceProvider"
			],
			"aliases": {
				"Gatekeepr": "Gatekeepr\\Laravel\\Facades\\Gatekeepr"
			}
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"homepage": "https://github.com/suciudan/gatekeepr",
	"support": {
		"issues": "https://github.com/suciudan/gatekeepr/issues",
		"source": "https://github.com/suciudan/gatekeepr/tree/main/packages/laravel"
	}
}
