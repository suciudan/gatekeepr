# MySQL
REDIS_URL=redis://127.0.0.1:6379
MYSQL_HOST=127.0.0.1
MYSQL_DB=
MYSQL_USER=
MYSQL_PASS=
MYSQL_PORT=

# PeerDB
PEERDB_API_KEY=

# Slack
SLACK_ERRORS_CRON=
SLACK_STATUS_CRON=

# Disposable domain package publisher (explicit opt-in)
DISPOSABLE_PUBLISH_ENABLED=false
DISPOSABLE_PUBLISH_REPO=your-org/email-disposable
DISPOSABLE_PUBLISH_BRANCH=main
DISPOSABLE_PUBLISH_GITHUB_TOKEN=
DISPOSABLE_PUBLISH_NPM_TOKEN=
DISPOSABLE_PUBLISH_GIT_NAME=Gatekeepr Bot
DISPOSABLE_PUBLISH_GIT_EMAIL=bot@example.com

# Browser-version dataset publisher (explicit opt-in)
BROWSER_VERSIONS_PUBLISH_ENABLED=false
BROWSER_VERSIONS_PUBLISH_REPO=your-org/browser-versions
BROWSER_VERSIONS_PUBLISH_BRANCH=main
BROWSER_VERSIONS_PUBLISH_GITHUB_TOKEN=
BROWSER_VERSIONS_PUBLISH_GIT_NAME=Gatekeepr Bot
BROWSER_VERSIONS_PUBLISH_GIT_EMAIL=bot@example.com
BROWSER_VERSIONS_PACKAGE_NAME=browser-versions

# Disposable email infrastructure publisher
DISPOSABLE_INFRASTRUCTURE_SOURCE_URL=https://raw.githubusercontent.com/gtkppr/email-disposable/refs/heads/main/disposable.json
DISPOSABLE_INFRASTRUCTURE_SOURCE_PACKAGE_URL=https://raw.githubusercontent.com/gtkppr/email-disposable/refs/heads/main/package.json
DISPOSABLE_INFRASTRUCTURE_PUBLISH_ENABLED=false
DISPOSABLE_INFRASTRUCTURE_PUBLISH_REPO=your-org/disposable-email-infrastructure
DISPOSABLE_INFRASTRUCTURE_PUBLISH_BRANCH=main
DISPOSABLE_INFRASTRUCTURE_GITHUB_TOKEN=
DISPOSABLE_INFRASTRUCTURE_GIT_NAME=Gatekeepr Bot
DISPOSABLE_INFRASTRUCTURE_GIT_EMAIL=bot@example.com
DISPOSABLE_INFRASTRUCTURE_OUTPUT_DIR=
DISPOSABLE_INFRASTRUCTURE_DNS_SERVERS=127.0.0.1:5353
DISPOSABLE_INFRASTRUCTURE_MX_REFRESH_LIMIT=250
DISPOSABLE_INFRASTRUCTURE_MX_REFRESH_CONCURRENCY=10
DISPOSABLE_INFRASTRUCTURE_MX_RESOLVE_CONCURRENCY=10
DISPOSABLE_INFRASTRUCTURE_MX_TIMEOUT_MS=3000
DISPOSABLE_INFRASTRUCTURE_IP_TIMEOUT_MS=2000
DISPOSABLE_INFRASTRUCTURE_PREWARM_ENABLED=false
DISPOSABLE_INFRASTRUCTURE_PREWARM_BASE_URL=http://localhost:9999
DISPOSABLE_INFRASTRUCTURE_PREWARM_TOP_PROVIDERS=10
DISPOSABLE_INFRASTRUCTURE_PREWARM_TIMEOUT_MS=10000
DISPOSABLE_INFRASTRUCTURE_PREWARM_URLS=

# Set to true to make refresh-disposable-mx-all publish the public infrastructure repo after a successful refresh.
DISPOSABLE_MX_FULL_REFRESH_PUBLISH=false
