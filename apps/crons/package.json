{
  "name": "crons",
  "packageManager": "yarn@4.9.2",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@repo/browser-versions": "*",
    "@repo/core": "*",
    "@repo/db": "*",
    "p-limit": "^6.2.0"
  },
  "scripts": {
    "backfill:disposable": "node src/backfill-disposable-domains.js",
    "reset:usage:daily": "node src/reset-rpm.js",
    "export:disposable": "node src/export-disposable-domains.js",
    "publish:browser-versions": "node src/publish-browser-versions.js",
    "publish:browser-versions:dry": "node src/publish-browser-versions.js --dry-run",
    "publish:disposable": "node src/publish-disposable-domains.js",
    "publish:disposable:dry": "node src/publish-disposable-domains.js --dry-run",
    "publish:disposable-infrastructure": "node src/publish-disposable-infrastructure.js",
