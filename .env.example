# Gatekeepr does not use a root runtime environment file.
# Copy the app-specific examples you need, without overwriting local settings:
#
# cp apps/api/.env.sample apps/api/.env.local
# cp apps/site/.env.sample apps/site/.env.local
# cp apps/crons/.env.sample apps/crons/.env.local
# cp apps/dash/.env.example apps/dash/.env
#
# See docs/Development.md for services, migrations, and a local API key.
# Never put real credentials in this example.
